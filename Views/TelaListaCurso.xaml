<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appProvaA1Curso.Views.TelaListaCurso"
             Title="Lista de Cursos"
             BackgroundColor="#F8F9FA">

    <!-- Barra de Menu com o método para Incluir um Novo Curso -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Incluir" 
                     IconImageSource="add_icon.png"
                     Clicked="irTelaIncluirCurso" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <StackLayout>
            <!-- Campo de Busca (Pesquisa) -->
            <SearchBar x:Name="txtBusca" 
                       Margin="-10, 0, 0, 0" 
                       Placeholder="Qual o Curso?" 
                       PlaceholderColor="#6C757D"
                       TextColor="#212529"
                       BackgroundColor="#FFFFFF"
                       TextChanged="txtBuscar" />

            <!-- RefreshView envolvendo CollectionView: suporta EmptyView e PullToRefresh -->
            <RefreshView x:Name="refreshView"
                         Refreshing="refCarregando"
                         BackgroundColor="#F8F9FA">

                <CollectionView x:Name="lstCursos"
                                SelectionMode="Single"
                                SelectionChanged="lstCursosItemSelected"
                                BackgroundColor="#F8F9FA"
                                ItemsLayout="VerticalList">

                    <!-- Cabeçalho da tabela -->
                    <CollectionView.Header>
                        <Grid RowDefinitions="Auto" 
                              ColumnDefinitions="60, *, 100"
                              BackgroundColor="#0D6EFD"
                              Padding="12,8">
                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="ID" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="Nome do Curso" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Start"/>
                            <Label Grid.Row="0" Grid.Column="2" 
                                   Text="Carga Horária" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"/>
                        </Grid>
                    </CollectionView.Header>

                    <!-- Template das linhas usando SwipeView para ação de excluir -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Excluir Curso"
                                                   IconImageSource="delete_icon.png"
                                                   BackgroundColor="LightCoral"
                                                   Invoked="excluirCurso" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid RowDefinitions="Auto" 
                                      ColumnDefinitions="60, *, 100"
                                      Padding="12,12"
                                      BackgroundColor="White"
                                      Margin="0,0,0,1">

                                    <Label Grid.Row="0" Grid.Column="0" 
                                           Text="{Binding Id}" 
                                           TextColor="#212529"
                                           FontAttributes="Bold" 
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>

                                    <Label Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding Nome}" 
                                           TextColor="#212529"
                                           FontSize="14"
                                           VerticalTextAlignment="Center"/>

                                    <Label Grid.Row="0" Grid.Column="2" 
                                           Text="{Binding CargaHoraria, StringFormat='{0}h'}" 
                                           TextColor="#0D6EFD"
                                           FontAttributes="Bold" 
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Quando não há dados -->
                    <CollectionView.EmptyView>
                        <StackLayout Padding="40" Spacing="16" 
                                     HorizontalOptions="Center" 
                                     VerticalOptions="Center">
                            <Label Text="📚" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="Nenhum curso cadastrado"
                                   FontSize="16"
                                   TextColor="#6C757D"
                                   HorizontalOptions="Center"/>
                            <Label Text="Clique em Incluir para adicionar"
                                   FontSize="12"
                                   TextColor="#0D6EFD"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>

                </CollectionView>
            </RefreshView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>