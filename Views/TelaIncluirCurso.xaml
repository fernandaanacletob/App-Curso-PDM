<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="appProvaA1Curso.Views.TelaIncluirCurso"
    Title="Incluir Curso">

    <Grid>

        <Image Source="fundocurso.png"
               Aspect="AspectFill"/>

        <ScrollView>

            <Frame BackgroundColor="#FFFFFFDD"
                   Margin="20"
                   CornerRadius="25"
                   Padding="25"
                   VerticalOptions="Center">

                <StackLayout Spacing="20">

                    <Image Source="incluircurso.png"
                           HeightRequest="100"
                           HorizontalOptions="Center"/>

                    <Label Text="Cadastrar Curso"
                           FontSize="30"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Entry Placeholder="Nome do Curso"
                           BackgroundColor="White"
                           HeightRequest="50"/>

                    <Entry Placeholder="Carga Horária"
                           Keyboard="Numeric"
                           BackgroundColor="White"
                           HeightRequest="50"/>

                    <Button Text="Salvar"
                            ImageSource="salvarcurso.png"
                            BackgroundColor="#228B22"
                            TextColor="White"
                            HeightRequest="55"
                            CornerRadius="20"/>

                </StackLayout>

            </Frame>

        </ScrollView>

    </Grid>

</ContentPage>